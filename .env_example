HA_TOKEN=your-long-lived-access-token
HA_URL=http://homeassistant.local:8123

# Only needed by scripts/ghost_report.py, and only one of the two.
# Read-only either way: the script sends SELECT statements only.
#
# Preferred — a path to the recorder file, opened read-only via sqlite3.
# Same thing as passing --db on the command line.
HA_RECORDER_DB=/path/to/config/home-assistant_v2.db
#
# Alternative — a sqlite_web instance serving that same file.
# SQLITE_WEB_URL=http://homeassistant.local:8088
